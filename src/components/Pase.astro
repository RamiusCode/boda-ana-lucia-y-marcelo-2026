---
// Pase.astro
interface Props {
    numeroPases: number;
    nombreInvitado?: string;
}

const { numeroPases = 3, nombreInvitado = "Familia Rodríguez Vargas" } =
    Astro.props;

// El nombre va SIEMPRE en una sola línea. Como la card es de ancho
// fijo (300px), el cuerpo se ajusta al largo del nombre por tramos.
const largo = nombreInvitado.length;
const tamanoNombre =
    largo <= 14
        ? "2.2rem"
        : largo <= 20
          ? "1.9rem"
          : largo <= 26
            ? "1.6rem"
            : largo <= 34
              ? "1.3rem"
              : "1.1rem";
---

<section class="relative w-full pt-10 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-pase">

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-pase">
                        <img
                            src="/imagenes/boton.webp"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden"
                    id="card-principal-pase"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/azul.png"
                        alt="Fondo pase"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div class="relative px-6 pt-16 pb-10 z-10 text-center">

                        <!-- NOMBRE DEL INVITADO (una sola línea) -->
                        <div class="mb-4" id="titulo-pase">
                            <p
                                class="font-crimson text-base uppercase text-white/75 mb-4"
                            >
                                Con mucho cariño para
                            </p>
                            <h2
                                id="nombre-invitado"
                                class="font-great-vibes text-white leading-tight whitespace-nowrap"
                                style={`font-size: ${tamanoNombre};`}
                            >
                                {nombreInvitado}
                            </h2>
                        </div>

                        <!-- SEPARADOR DORADO -->
                        <div class="flex items-center justify-center gap-2 mb-4">
                            <div class="w-10 h-px bg-[#b7956b]/70"></div>
                            <div class="w-1.5 h-1.5 rounded-full bg-[#b7956b]"></div>
                            <div class="w-10 h-px bg-[#b7956b]/70"></div>
                        </div>

                        <!-- FRASE + NÚMERO DE PASES -->
                        <div id="numero-pase">
                            <p
                                class="font-crimson text-lg leading-snug text-white/90"
                            >
                                Hemos reservado
                            </p>
                            <p
                                id="numero-pases"
                                class="text-white font-bold leading-none mt-2"
                                style="font-size: 3.75rem; text-shadow: 0 4px 16px rgba(0,0,0,0.2);"
                            >
                                {numeroPases}
                            </p>
                        </div>

                        <!-- PASES EN SU HONOR -->
                        <div class="mt-2" id="texto-pase">
                            <p
                                class="font-crimson text-lg leading-relaxed text-white/90 italic"
                            >
                                <span id="palabra-pases"
                                    >{numeroPases === 1 ? "pase" : "pases"}</span
                                > en su honor
                            </p>
                        </div>

                        <!-- ICONOS DE PERSONAS -->
                        <div class="flex justify-center gap-3 mt-6" id="iconos-pase">
                            {
                                Array.from({ length: numeroPases }).map((_, index) => (
                                    <div
                                        class="w-9 h-9 rounded-full bg-white/20 border border-white/40 flex items-center justify-center"
                                        style={`animation-delay: ${index * 0.2}s;`}
                                    >
                                        <svg
                                            class="w-5 h-5 text-white"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                        </svg>
                                    </div>
                                ))
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { datosInvitado, alCambiarInvitado } from "../lib/invitado";

    gsap.registerPlugin(ScrollTrigger);

    // ═══════════════════════════════════════════════════════════
    // 🎟️ PASE PERSONALIZADO
    // El link trae solo un código (?i=k7m2p); el nombre y los pases viven en
    // la base. Si los novios corrigen un nombre en el panel, el link YA
    // ENVIADO muestra el nombre corregido sin reenviar nada.
    // ═══════════════════════════════════════════════════════════

    // El nombre va SIEMPRE en una sola línea dentro de una card de 300px:
    // el cuerpo se ajusta por tramos según el largo. Misma escala que usa
    // el render del servidor, para que no se note el cambio.
    function tamanoParaNombre(nombre) {
        const largo = nombre.length;
        if (largo <= 14) return "2.2rem";
        if (largo <= 20) return "1.9rem";
        if (largo <= 26) return "1.6rem";
        if (largo <= 34) return "1.3rem";
        return "1.1rem";
    }

    function pintarPase(nombre, pases) {
        if (nombre) {
            const el = document.getElementById("nombre-invitado");
            if (el) {
                el.textContent = nombre;
                el.style.fontSize = tamanoParaNombre(nombre);
            }
        }

        if (Number.isInteger(pases) && pases > 0) {
            const num = document.getElementById("numero-pases");
            const palabra = document.getElementById("palabra-pases");
            if (num) num.textContent = String(pases);
            if (palabra) palabra.textContent = pases === 1 ? "pase" : "pases";

            // Los monigotes tienen que coincidir con el número
            const iconos = document.getElementById("iconos-pase");
            if (iconos) {
                const molde = iconos.firstElementChild;
                if (molde) {
                    iconos.innerHTML = "";
                    for (let i = 0; i < pases; i++) {
                        const copia = molde.cloneNode(true);
                        copia.style.animationDelay = i * 0.2 + "s";
                        iconos.append(copia);
                    }
                }
            }
        }
    }

    if (typeof window !== "undefined") {
        // Si no hay código en el link, datosInvitado() devuelve null al toque
        // y la card se queda con los valores por defecto.
        function mostrarInvitado(inv) {
            if (!inv) return;

            // Hay clientes que no usan pases: su tarjeta muestra solo el
            // nombre. Sin esto quedaría un "1 pase en su honor" inventado.
            if (inv.funciones && inv.funciones.pases === false) {
                for (const id of ["numero-pase", "texto-pase", "iconos-pase"]) {
                    const el = document.getElementById(id);
                    if (el) el.style.display = "none";
                }
                pintarPase(inv.nombre, null);
                return;
            }

            pintarPase(inv.nombre, inv.pases);
        }

        datosInvitado().then(mostrarInvitado);

        // Si los novios corrigen el nombre o los pases mientras el invitado
        // tiene la invitación abierta, la tarjeta se actualiza sola.
        alCambiarInvitado(mostrarInvitado);

        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-pase",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-pase",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#titulo-pase",
                { opacity: 0, y: -20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#numero-pase",
                { opacity: 0, scale: 0.8 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 1,
                    delay: 0.2,
                    ease: "back.out(1.4)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#texto-pase",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#iconos-pase",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.6,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>
