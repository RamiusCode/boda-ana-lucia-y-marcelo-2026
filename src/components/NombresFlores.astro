---
// SobreFoto.astro
---

<!-- ═══════════════════════════════════════════════════════════ --><!-- 💌 SECCIÓN: SOBRE CON FOTO + TARJETAS                       --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-8 pb-4 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-2 sm:px-6 lg:px-8">
        <!-- 💌 SOBRE CON FOTO EN CAPAS -->
        <div
            class="relative w-full flex justify-center mb-6 sm:mb-10 md:mb-14"
            id="sobre-container"
        >
            <div
                class="relative w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg"
            >
                <!-- CAPA 1: SOBRE TRASERO (base) -->
                <img
                    src="/imagenes/sobre1.png"
                    alt="Sobre trasero"
                    class="w-full h-auto object-contain"
                    id="sobre-atras"
                />

                <!-- CAPA 2: FOTO saliendo por arriba -->
                <img
                    src="/imagenes/foto1.webp"
                    alt="Foto novios"
                    class="absolute w-[85%] object-contain drop-shadow-lg"
                    style="left: 50%; top: 7%; transform: translate(-50%, 8%) rotate(5deg); z-index: 2;"
                    id="sobre-imagen"
                />

                <!-- CAPA 3: SOBRE DELANTERO (tapa la parte inferior) -->
                <img
                    src="/imagenes/sobre2.png"
                    alt="Sobre delantero"
                    class="absolute bottom-0 left-0 w-full h-auto object-contain"
                    style="z-index: 3;"
                    id="sobre-frente"
                />
            </div>
        </div>

        <!-- 📇 TARJETAS -->
        <div
            class="relative w-full flex flex-row justify-center items-start gap-3 sm:gap-6 md:gap-12 lg:gap-16"
            id="tarjetas-container"
        >
            <!-- 📇 TARJETA IZQUIERDA: NOS CASAMOS -->
            <div
                class="relative w-1/2 max-w-[160px] xs:max-w-[160px] sm:max-w-[200px] md:max-w-[240px] lg:max-w-[260px] mt-8 sm:mt-8 md:mt-12"
                id="tarjeta-izquierda"
            >
                <div
                    class="relative rounded-sm shadow-xl overflow-hidden h-full"
                >
                    <img
                        src="/imagenes/fondorojo.png"
                        alt="Fondo tarjeta"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/20"></div>
                    <div
                        class="relative p-6 sm:p-6 md:p-8 text-center flex flex-col justify-center min-h-[320px] xs:min-h-[360px] sm:min-h-[420px] md:min-h-[480px] z-10"
                    >
                        <div class="mb-6 sm:mb-6">
                            <p
                                class="font-crimson text-base xs:text-[10px] sm:text-xs md:text-sm text-[#122a4d] uppercase tracking-widest mb-2 sm:mb-4"
                            >
                                Nos Casamos
                            </p>
                        </div>
                        <h3
                            class="font-great-vibes text-4xl xs:text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#122a4d] mb-2 sm:mb-3 leading-snug"
                        >
                            Ana Lucía
                        </h3>
                        <div
                            class="text-[#122a4d] text-3xl xs:text-2xl sm:text-3xl md:text-4xl font-charm my-2 sm:my-3"
                        >
                            &
                        </div>
                        <h3
                            class="font-great-vibes text-4xl xs:text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#122a4d] mt-2 sm:mt-3 leading-snug"
                        >
                            Marcelo
                        </h3>
                    </div>
                </div>
            </div>

            <!-- 📇 TARJETA DERECHA: FECHA -->
            <div
                class="relative w-1/2 max-w-[160px] xs:max-w-[160px] sm:max-w-[200px] md:max-w-[240px] lg:max-w-[260px]"
                id="tarjeta-derecha"
            >
                <div
                    class="relative rounded-sm shadow-xl overflow-hidden h-full"
                >
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo tarjeta"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    >
                    </div>
                    <div
                        class="relative px-3 py-6 sm:px-4 sm:py-6 md:px-5 md:py-8 h-full flex flex-col justify-center items-center gap-4 sm:gap-5 md:gap-6 min-h-[320px] xs:min-h-[360px] sm:min-h-[420px] md:min-h-[480px] z-10"
                    >
                        <!-- SEPARADOR SUPERIOR (CON ANILLOS) -->
                        <div class="flex items-center justify-center w-full">
                            <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                            <img
                                src="/imagenes/anillo.png"
                                alt="Anillos"
                                class="mx-2 w-7 sm:w-8 md:w-9 h-auto object-contain shrink-0"
                                style="filter: brightness(0) saturate(100%) invert(13%) sepia(31%) saturate(1876%) hue-rotate(186deg) brightness(95%) contrast(96%);"
                            />
                            <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                        </div>

                        <!-- FECHA -->
                        <div class="text-center">
                            <p
                                class="font-charm text-2xl xs:text-2xl sm:text-3xl md:text-4xl text-[#122a4d] font-bold leading-none whitespace-nowrap"
                            >
                                10/10/2026
                            </p>
                            <p
                                class="font-crimson italic text-[13px] xs:text-sm sm:text-[15px] md:text-lg text-[#274c77] mt-2 leading-tight"
                            >
                                (sábado 10 de octubre)
                            </p>
                        </div>

                        <!-- SEPARADOR INFERIOR -->
                        <div class="flex items-center justify-center w-full">
                            <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                            <div
                                class="mx-2 text-[#b7956b] text-[10px] sm:text-xs"
                            >
                                ✦
                            </div>
                            <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                        </div>

                        <!-- CELEBREMOS JUNTOS -->
                        <p
                            class="font-crimson text-sm sm:text-base text-[#122a4d] uppercase tracking-[0.2em] leading-relaxed text-center"
                        >
                            CELEBREMOS<br />JUNTOS
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎵 BOTÓN FLOTANTE PLAY/PAUSE                                -->
<!-- ═══════════════════════════════════════════════════════════ -->
<button
    id="btn-audio-control"
    aria-label="Controlar música"
    class="fixed bottom-6 right-6 z-[9999] w-12 h-12 rounded-full shadow-lg
           bg-white border border-[#122a4d]/20 flex items-center justify-center
           transition-all duration-300 hover:scale-110 active:scale-95"
    style="opacity: 0; pointer-events: none;"
>
    <svg
        id="icono-pause"
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-[#122a4d]"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <rect x="6" y="4" width="4" height="16" rx="1"></rect>
        <rect x="14" y="4" width="4" height="16" rx="1"></rect>
    </svg>
    <svg
        id="icono-play"
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-[#122a4d] hidden"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <path d="M8 5v14l11-7z"></path>
    </svg>
</button>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // ═══ SOBRE TRASERO ═══
        gsap.fromTo(
            "#sobre-atras",
            { opacity: 0, scale: 0.9 },
            {
                opacity: 1,
                scale: 1,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#sobre-container",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ SOBRE DELANTERO ═══
        gsap.fromTo(
            "#sobre-frente",
            { opacity: 0 },
            {
                opacity: 1,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#sobre-container",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ FOTO SUBE SALIENDO DEL SOBRE ═══
        gsap.fromTo(
            "#sobre-imagen",
            { opacity: 0, y: 35, rotation: 5 },
            {
                opacity: 1,
                y: 20,
                rotation: 5,
                duration: 2.2,
                ease: "sine.out",
                delay: 0.8,
                scrollTrigger: {
                    trigger: "#sobre-container",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
                onComplete: () => {
                    // ═══ FOTO FLOTA SUAVEMENTE ═══
                    gsap.to("#sobre-imagen", {
                        y: 12,
                        rotation: 5,
                        duration: 2.5,
                        ease: "sine.inOut",
                        yoyo: true,
                        repeat: -1,
                    });
                },
            },
        );

        // ═══ TARJETA IZQUIERDA ═══
        gsap.fromTo(
            "#tarjeta-izquierda",
            { opacity: 0, x: -50 },
            {
                opacity: 1,
                x: 0,
                duration: 1.6,
                ease: "sine.out",
                delay: 0.2,
                scrollTrigger: {
                    trigger: "#tarjetas-container",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ TARJETA DERECHA ═══
        gsap.fromTo(
            "#tarjeta-derecha",
            { opacity: 0, x: 50 },
            {
                opacity: 1,
                x: 0,
                duration: 1.6,
                ease: "sine.out",
                delay: 0.4,
                scrollTrigger: {
                    trigger: "#tarjetas-container",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ BOTÓN FLOTANTE PLAY/PAUSE ═══
        const btnAudio = document.getElementById(
            "btn-audio-control",
        ) as HTMLButtonElement;
        const iconoPlay = document.getElementById("icono-play");
        const iconoPause = document.getElementById("icono-pause");

        const intervalo = setInterval(() => {
            const audio = (window as any).audioGlobal;
            if (audio) {
                clearInterval(intervalo);
                gsap.to(btnAudio, {
                    opacity: 1,
                    duration: 0.5,
                    ease: "power2.out",
                    onStart: () => {
                        btnAudio.style.pointerEvents = "auto";
                    },
                });
                iconoPlay?.classList.add("hidden");
                iconoPause?.classList.remove("hidden");

                btnAudio.addEventListener("click", () => {
                    const audioActual = (window as any).audioGlobal;
                    const reproduciendo = (window as any)
                        .estaReproduciendoGlobal;
                    if (!audioActual) return;
                    if (reproduciendo) {
                        audioActual.pause();
                        (window as any).estaReproduciendoGlobal = false;
                        iconoPause?.classList.add("hidden");
                        iconoPlay?.classList.remove("hidden");
                    } else {
                        audioActual.play();
                        (window as any).estaReproduciendoGlobal = true;
                        iconoPlay?.classList.add("hidden");
                        iconoPause?.classList.remove("hidden");
                    }
                    gsap.fromTo(
                        btnAudio,
                        { scale: 0.85 },
                        { scale: 1, duration: 0.3, ease: "back.out(2)" },
                    );
                });
            }
        }, 300);
    });
</script>

<style>
    #tarjetas-container {
        perspective: 1000px;
    }
    #tarjeta-izquierda > div,
    #tarjeta-derecha > div {
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }
    #tarjeta-izquierda > div:hover,
    #tarjeta-derecha > div:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }
</style>
