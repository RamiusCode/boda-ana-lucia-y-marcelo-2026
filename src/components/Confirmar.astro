---
// Confirmar.astro
// Datos por invitado, se pasan desde la página:
//   <Confirmar nombreInvitado="Familia Rodríguez Vargas" numeroPases={3} />
interface Props {
    nombreInvitado?: string;
    numeroPases?: number;
}

const { nombreInvitado = "Familia Rodríguez Vargas", numeroPases = 3 } =
    Astro.props;
---

<!-- ═══════════════════════════════════════════════════════════ --><!-- 💬 SECCIÓN: CONFIRMA TU ASISTENCIA                         --><!-- ═══════════════════════════════════════════════════════════ -->
<section id="seccion-confirmar" class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE CONFIRMAR ASISTENCIA -->
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-confirmar">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div
                        class="w-16 h-16 sm:w-20 sm:h-20"
                        id="boton-decorativo-confirmar"
                    >
                        <img
                            src="/imagenes/boton.webp"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-confirmar"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo confirmar"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div
                        class="relative px-6 py-12 sm:px-8 sm:py-14 z-10 flex flex-col items-center justify-center"
                    >
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-6" id="titulo-confirmar">
                            <h2
                                class="font-crimson text-2xl sm:text-3xl md:text-4xl text-[#122a4d] uppercase tracking-wide font-bold"
                            >
                                Confirma Tu<br />Asistencia
                            </h2>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div class="text-center mb-8" id="texto-confirmar">
                            <p
                                class="font-crimson text-xl sm:text-lg text-[#274c77] leading-relaxed"
                            >
                                Será de mucha alegría<br />
                                para nosotros contar<br />
                                con tu compañía en este<br />
                                día tan importante.
                            </p>
                        </div>
                        <!-- BOTONES FORMULARIO -->
                        <div
                            class="flex flex-col items-center gap-4 w-full"
                            id="boton-formulario-confirmar"
                        >
                            <!-- BOTÓN CONFIRMAR (ABRE EL MODAL) -->
                            <button
                                type="button"
                                id="btn-abrir-confirmacion"
                                class="inline-flex w-full max-w-xs
                            items-center justify-center gap-2 px-6 py-3 sm:px-8
                            sm:py-4 bg-[#122a4d] border-2 border-[#b7956b] rounded-full shadow-lg
                            hover:shadow-xl hover:bg-[#1a3d6b] transition-all
                            duration-300 cursor-pointer"
                                aria-label="Confirmar asistencia"
                            >
                                <svg
                                    class="w-5 h-5 sm:w-6 sm:h-6 text-white shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                    ></path>
                                </svg>

                                <span
                                    class="font-crimson text-base sm:text-lg text-white font-semibold uppercase tracking-wider whitespace-nowrap"
                                >
                                    Confirmar Asistencia
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🎬 ANIMACIONES CON GSAP                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        if (typeof window !== "undefined") {
            document.addEventListener("DOMContentLoaded", () => {
                console.log(
                    "💬 Iniciando animaciones de confirmar asistencia...",
                );

                // Animación del botón decorativo
                gsap.fromTo(
                    "#boton-decorativo-confirmar",
                    {
                        opacity: 0,
                        scale: 0,
                        rotation: -180,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "back.out(1.7)",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de la card
                gsap.fromTo(
                    "#card-principal-confirmar",
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del título
                gsap.fromTo(
                    "#titulo-confirmar",
                    {
                        opacity: 0,
                        y: -20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.3,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del texto
                gsap.fromTo(
                    "#texto-confirmar",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.5,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del botón
                gsap.fromTo(
                    "#boton-formulario-confirmar",
                    {
                        opacity: 0,
                        scale: 0.8,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.7,
                        ease: "back.out(1.5)",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación continua del botón decorativo
                gsap.to("#boton-decorativo-confirmar", {
                    y: -5,
                    duration: 2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: 1,
                });

                // Animación continua del botón formulario
                gsap.to("#boton-formulario-confirmar a", {
                    y: -3,
                    duration: 2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: 1,
                });

                console.log(
                    "💬✨ ¡Animaciones de confirmar asistencia activadas!",
                );
            });
        }
    </script>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🎨 ESTILOS CSS                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style>
        /* Efecto hover en la card */
        #card-principal-confirmar {
            transition: all 0.4s ease;
        }

        #card-principal-confirmar:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px rgba(18, 42, 77, 0.25);
        }

        /* Efecto en el botón */
        #boton-formulario-confirmar a:focus {
            outline: none;
        }

        #boton-formulario-confirmar a:active {
            outline: none;
            transform: scale(0.95);
        }
    </style>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 💌 MODAL DE CONFIRMACIÓN DE ASISTENCIA                      -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
    id="modal-confirmacion"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    style="opacity: 0; transition: opacity 0.3s ease; backdrop-filter: blur(8px);"
    data-nombre={nombreInvitado}
    data-pases={numeroPases}
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-titulo"
>
    <!-- FONDO -->
    <div class="absolute inset-0 bg-[#122a4d]/50" id="modal-fondo"></div>

    <!-- CAJA -->
    <div class="relative w-full max-w-sm z-10" id="modal-caja">
        <div
            class="relative rounded-[32px] shadow-2xl overflow-hidden bg-[#f5f5f5]"
        >
            <img
                src="/imagenes/fondoplomo.png"
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
            />

            <div class="relative px-7 py-9 z-10 text-center">
                <!-- CERRAR -->
                <button
                    type="button"
                    id="modal-cerrar"
                    class="absolute top-2 right-4 text-2xl leading-none text-[#122a4d]/45 hover:text-[#122a4d] transition-colors cursor-pointer"
                    aria-label="Cerrar"
                >
                    &times;
                </button>

                <!-- ═══ PASO 1: CONFIRMACIÓN ═══ -->
                <div id="paso-confirmar">
                    <p
                        class="font-crimson text-[15px] uppercase tracking-[0.08em] text-[#274c77] mb-3"
                        id="modal-titulo"
                    >
                        Confirmación de asistencia
                    </p>

                    <p
                        data-nombre-modal
                        class="font-great-vibes text-[2rem] leading-tight text-[#122a4d] mb-4"
                    >
                        {nombreInvitado}
                    </p>

                    <!-- SEPARADOR DORADO -->
                    <div class="flex items-center justify-center w-full mb-5">
                        <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                        <div class="mx-3 text-[#b7956b] text-sm">&#10038;</div>
                        <div class="flex-1 h-px bg-[#b7956b]/50"></div>
                    </div>

                    <p data-pases-modal class="font-crimson text-base text-[#274c77] mb-4">
                        {
                            numeroPases === 1
                                ? "Tienes 1 pase reservado."
                                : `Tienes ${numeroPases} pases reservados.`
                        }
                    </p>

                    <!-- ¿CUÁNTOS VIENEN? (solo si tiene más de un pase) -->
                    <div id="caja-cuantos" class="hidden mb-5">
                        <p
                            class="font-crimson text-sm uppercase tracking-[0.12em] text-[#274c77] mb-3"
                        >
                            ¿Cuántos vienen?
                        </p>
                        <div
                            class="flex items-center justify-center gap-4"
                        >
                            <button
                                type="button"
                                id="btn-menos"
                                class="w-10 h-10 rounded-full border-2 border-[#b7956b] text-[#122a4d] text-xl leading-none flex items-center justify-center hover:bg-[#b7956b]/15 transition-colors cursor-pointer"
                                aria-label="Uno menos"
                            >−</button>
                            <span
                                id="cuantos-vienen"
                                class="font-crimson text-3xl text-[#122a4d] font-bold w-10 text-center"
                            >1</span>
                            <button
                                type="button"
                                id="btn-mas"
                                class="w-10 h-10 rounded-full border-2 border-[#b7956b] text-[#122a4d] text-xl leading-none flex items-center justify-center hover:bg-[#b7956b]/15 transition-colors cursor-pointer"
                                aria-label="Uno más"
                            >+</button>
                        </div>
                    </div>

                    <!-- NOMBRES DE QUIENES LO ACOMPAÑAN -->
                    <div id="caja-acompanantes" class="hidden mb-5 text-left">
                        <p
                            class="font-crimson text-sm uppercase tracking-[0.12em] text-[#274c77] mb-3 text-center"
                        >
                            ¿Quiénes te acompañan?
                        </p>
                        <div id="campos-acompanantes" class="flex flex-col gap-2"></div>
                    </div>

                    <div class="flex flex-col items-center gap-3">
                        <button
                            type="button"
                            id="btn-confirmar-final"
                            class="w-full px-6 py-3 bg-[#122a4d] border-2 border-[#b7956b] rounded-full font-crimson text-base text-white font-semibold uppercase tracking-wider shadow-lg hover:bg-[#1a3d6b] transition-all duration-300 cursor-pointer"
                        >
                            Confirmar asistencia
                        </button>
                        <button
                            type="button"
                            id="btn-no-asistire"
                            class="font-crimson text-sm text-[#274c77] underline underline-offset-4 hover:text-[#122a4d] transition-colors cursor-pointer"
                        >
                            No podré asistir
                        </button>
                    </div>
                </div>

                <!-- ═══ PASO 2: AGRADECIMIENTO ═══ -->
                <div id="paso-gracias" class="hidden">
                    <div class="flex justify-center mb-4">
                        <div
                            class="w-16 h-16 rounded-full bg-[#f2e8da] border-2 border-[#b7956b]/60 flex items-center justify-center"
                        >
                            <svg
                                class="w-8 h-8 text-[#b7956b]"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </div>

                    <p
                        class="font-great-vibes text-[2rem] leading-tight text-[#122a4d] mb-3"
                        id="titulo-gracias"
                    >
                        ¡Gracias!
                    </p>

                    <p
                        class="font-crimson text-base text-[#274c77] leading-relaxed mb-6"
                        id="texto-gracias"
                    >
                    </p>

                    <button
                        type="button"
                        id="btn-cerrar-gracias"
                        class="px-6 py-2.5 border-2 border-[#b7956b] rounded-full font-crimson text-sm text-[#122a4d] font-semibold uppercase tracking-wider bg-[#f2e8da]/50 hover:bg-[#b7956b]/20 transition-all duration-300 cursor-pointer"
                    >
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ═══════════════════════════════════════════════════════════
    // 💾 DÓNDE SE GUARDA LA CONFIRMACIÓN
    // En Supabase, en la fila del propio invitado. Se identifica por el
    // código que trae el link (?i=k7m2p): nadie puede confirmar por otro.
    // El panel /admin lo ve aparecer en vivo, sin recargar.
    //
    // Si el link NO trae código (alguien entró a la invitación pelada) o si
    // la base no responde, el modal igual agradece: la invitación nunca se
    // rompe delante del invitado.
    // ═══════════════════════════════════════════════════════════
    import { datosInvitado, confirmarAsistencia } from "../lib/invitado";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("modal-confirmacion");
            const abrir = document.getElementById("btn-abrir-confirmacion");
            if (!modal || !abrir) return;

            const cerrar = document.getElementById("modal-cerrar");
            const fondo = document.getElementById("modal-fondo");
            const btnConfirmar = document.getElementById("btn-confirmar-final");
            const btnNo = document.getElementById("btn-no-asistire");
            const btnCerrarGracias =
                document.getElementById("btn-cerrar-gracias");
            const pasoForm = document.getElementById("paso-confirmar");
            const pasoGracias = document.getElementById("paso-gracias");
            const tituloGracias = document.getElementById("titulo-gracias");
            const textoGracias = document.getElementById("texto-gracias");

            // Valores por defecto del render; se reemplazan con lo que diga
            // la base en cuanto llegue la respuesta.
            // Cuántos vienen y con quién. Se completan al llegar los datos
            // del invitado; si la boda no tiene esas funciones, quedan así.
            let cuantosVienen = 1;
            let conAcompanantes = false;

            const $ = (id) => document.getElementById(id);

            function pintarCuantos() {
                const marcador = $("cuantos-vienen");
                if (marcador) marcador.textContent = String(cuantosVienen);

                const menos = $("btn-menos");
                const mas = $("btn-mas");
                if (menos) menos.disabled = cuantosVienen <= 1;
                if (mas) mas.disabled = cuantosVienen >= pases;
                for (const b of [menos, mas]) {
                    if (b) b.style.opacity = b.disabled ? "0.35" : "1";
                }

                if (conAcompanantes) pintarCamposAcompanantes();
            }

            // Un campo por acompañante: el invitado principal ya está en la
            // invitación, así que van cuantosVienen - 1.
            function pintarCamposAcompanantes() {
                const caja = $("campos-acompanantes");
                if (!caja) return;

                const faltan = Math.max(cuantosVienen - 1, 0);
                caja.parentElement.classList.toggle("hidden", faltan === 0);

                // Lo ya escrito no se pierde al cambiar la cantidad
                const escritos = Array.from(
                    caja.querySelectorAll("input")
                ).map((i) => i.value);

                caja.innerHTML = "";
                for (let i = 0; i < faltan; i++) {
                    const campo = document.createElement("input");
                    campo.type = "text";
                    campo.maxLength = 60;
                    campo.value = escritos[i] ?? "";
                    campo.placeholder = "Nombre del acompañante " + (i + 1);
                    campo.className =
                        "w-full px-4 py-2.5 rounded-full border border-[#b7956b]/60 " +
                        "bg-white/70 font-crimson text-base text-[#122a4d] " +
                        "placeholder:text-[#274c77]/50 focus:outline-none " +
                        "focus:border-[#b7956b] transition-colors";
                    caja.append(campo);
                }
            }

            function nombresEscritos() {
                const caja = $("campos-acompanantes");
                if (!caja) return [];
                return Array.from(caja.querySelectorAll("input"))
                    .map((i) => i.value.trim())
                    .filter(Boolean);
            }

            $("btn-menos")?.addEventListener("click", () => {
                if (cuantosVienen > 1) { cuantosVienen--; pintarCuantos(); }
            });
            $("btn-mas")?.addEventListener("click", () => {
                if (cuantosVienen < pases) { cuantosVienen++; pintarCuantos(); }
            });

            let nombre = modal.dataset.nombre || "";
            let pases = parseInt(modal.dataset.pases || "1", 10);

            // Si el invitado ya había respondido antes, se le muestra su
            // respuesta en vez del formulario: no confirma dos veces sin querer.
            datosInvitado().then((inv) => {
                if (!inv) return;
                nombre = inv.nombre;
                pases = inv.pases;

                const titulo = modal.querySelector("[data-nombre-modal]");
                if (titulo) titulo.textContent = inv.nombre;

                const frase = modal.querySelector("[data-pases-modal]");
                if (frase) {
                    frase.textContent =
                        inv.pases === 1
                            ? "Tienes 1 pase reservado."
                            : `Tienes  pases reservados.`;
                }

                // El cliente puede no tener contratada la confirmación:
                // en ese caso la tarjeta entera no tiene sentido.
                if (inv.funciones && inv.funciones.confirmacion === false) {
                    const seccion = document.getElementById("seccion-confirmar");
                    if (seccion) seccion.style.display = "none";
                    return;
                }

                // ¿Cuántos vienen? Solo tiene sentido con más de un pase.
                cuantosVienen = inv.asisten && inv.asisten > 0 ? inv.asisten : inv.pases;
                conAcompanantes = Boolean(inv.funciones?.acompanantes);

                const cajaCuantos = document.getElementById("caja-cuantos");
                if (cajaCuantos) cajaCuantos.classList.toggle("hidden", inv.pases <= 1);

                // Lo que ya había respondido, ya cargado
                if (conAcompanantes && inv.acompanantes?.length) {
                    pintarCamposAcompanantes();
                    const campos = document
                        .getElementById("campos-acompanantes")
                        ?.querySelectorAll("input");
                    inv.acompanantes.forEach((n, i) => {
                        if (campos && campos[i]) campos[i].value = n;
                    });
                }
                pintarCuantos();

                if (inv.confirmado === true) {
                    mostrarGracias(
                        "Ya confirmaste",
                        inv.asisten === 1
                            ? "Tu asistencia ya está confirmada. ¡Te esperamos!"
                            : `Ya quedaron confirmadas ${inv.asisten} asistencias. ¡Los esperamos!`,
                    );
                } else if (inv.confirmado === false) {
                    mostrarGracias(
                        "Te extrañaremos",
                        "Ya nos avisaste que no podrás acompañarnos. Gracias por responder.",
                    );
                }
            });

            // ── ABRIR / CERRAR ──
            function abrirModal() {
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                document.body.style.overflow = "hidden";
                requestAnimationFrame(() => {
                    modal.style.opacity = "1";
                });
            }
            function cerrarModal() {
                modal.style.opacity = "0";
                document.body.style.overflow = "";
                setTimeout(() => {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                }, 300);
            }

            abrir.addEventListener("click", abrirModal);
            cerrar?.addEventListener("click", cerrarModal);
            fondo?.addEventListener("click", cerrarModal);
            btnCerrarGracias?.addEventListener("click", cerrarModal);
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && !modal.classList.contains("hidden"))
                    cerrarModal();
            });

            // ── ENVÍO ──
            async function registrar(asistira, cantidad) {
                // Nunca lanza: si la base está caída o el link no trae
                // código, devuelve null y el invitado igual ve el gracias.
                return await confirmarAsistencia(
                    asistira,
                    cantidad,
                    asistira && conAcompanantes ? nombresEscritos() : []
                );
            }

            function mostrarGracias(titulo, texto) {
                pasoForm.classList.add("hidden");
                pasoGracias.classList.remove("hidden");
                tituloGracias.textContent = titulo;
                textoGracias.textContent = texto;
            }

            btnConfirmar?.addEventListener("click", () => {
                btnConfirmar.disabled = true;
                btnConfirmar.textContent = "Enviando...";
                const vienen = cuantosVienen;
                registrar(true, vienen).finally(() => {
                    mostrarGracias(
                        "¡Gracias!",
                        vienen === 1
                            ? "Tu asistencia quedó confirmada. Nos vemos el sábado 10 de octubre."
                            : `Quedaron confirmadas ${vienen} asistencias. Nos vemos el sábado 10 de octubre.`,
                    );
                });
            });

            btnNo?.addEventListener("click", () => {
                registrar(false, 0).finally(() => {
                    mostrarGracias(
                        "Te extrañaremos",
                        "Gracias por avisarnos. Lamentamos que no puedas acompañarnos en este día.",
                    );
                });
            });
        });
    }
</script>
